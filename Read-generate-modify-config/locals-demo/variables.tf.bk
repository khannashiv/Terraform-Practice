provider "aws" {
  region = "us-east-1"
}

variable "firewall-sg" {
  type = map
  default = {
    name = "firewall-sg"
    # creation_date = "date-${formatdate("MM DD YYYY", timestamp())}"   ## O/P is : Error: Function calls not allowed
    # Creation_date = formatdate("MM DD YYYY", timestamp())             ## O/P is : Error: Function calls not allowed
  }
}

resource "aws_security_group" "sg-1" {
  name = "app-security-group"
  tags = var.firewall-sg
}

resource "aws_security_group" "sg-2" {
  name = "db-security-group"
  tags = var.firewall-sg
}
