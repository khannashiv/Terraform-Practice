provider "aws" {
  region = "us-east-1"
}

variable "firewall-sg" {
  type = map
  default = {
    name = "firewall-sg"
  }
}

resource "aws_security_group" "sg-1" {
  name = "app-security-group"
  tags = var.firewall-sg
}

resource "aws_security_group" "sg-2" {
  name = "db-security-group"
  tags = var.firewall-sg
}
